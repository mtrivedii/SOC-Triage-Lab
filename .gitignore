# secrets
.env
.env.*
!.env.example

# private / third-party data (HTB etc.), never commit
data/private/
results/raw_private/

# raw attack-tool output may contain secrets (e.g. a cracked password in the
# success scenario). Never commit it; the journal records the command instead.
data/raw/*/attack_output.txt

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# analyst decisions and generated reports stay local (example log is committed)
audit/audit_log.jsonl
reports/
